{
  "name": "pucked-video",
  "version": "0.1.0",
  "description": "Hudl-style video review for XBotGo Falcon game film. Hockey first, other sports via presets. Python server, browser screens, Electron window.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "server": "python -m server"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.puckedvideo.app",
    "productName": "Pucked Video",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "sports/**",
      "server/**/*.py",
      "server/requirements.txt"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "asar": false
  }
}
