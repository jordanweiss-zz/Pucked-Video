{
  "name": "video-review-app",
  "version": "0.1.0",
  "description": "Hudl-style video review for XBotGo Falcon game film. Hockey first, other sports via presets.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.videoreview.app",
    "productName": "Video Review",
    "files": ["main.js", "preload.js", "renderer/**", "sports/**"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" }
  }
}
